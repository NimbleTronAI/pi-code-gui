{
    "name": "pi-vscode-gui (VS Code extension dev)",

    "dockerComposeFile": "docker-compose.yml",
    "service": "app",

    "remoteUser": "node",
    "updateRemoteUserUID": false,
    "workspaceFolder": "/workspaces/pi-vscode-gui",

    // The compose volumes are `external` (so `compose down -v` can't delete them), which means
    // compose won't create them either. Runs on the host; `docker volume create` is a no-op
    // when the volume already exists.
    "initializeCommand": "docker volume create pi-vscode-gui-node-modules >/dev/null && docker volume create pi-vscode-gui-pi >/dev/null",

    "postCreateCommand": "sudo chown -R node:node /home/node/.pi /workspaces/pi-vscode-gui/node_modules && pnpm install",

    "postStartCommand": "bash .devcontainer/post-start.sh",

    "customizations": {
        "vscode": {
            "settings": {
                "pi-code-gui.systemPromptAppend": "/workspace/pi-code-gui/.pi/APPEND_SYSTEM.md"
            },
            "extensions": [
                "dbaeumer.vscode-eslint",
                "connor4312.esbuild-problem-matchers",
                "ms-vscode.extension-test-runner",
                "github.vscode-pull-request-github",
                "nimbletron.pi-code-gui"
            ]
        }
    }
}
