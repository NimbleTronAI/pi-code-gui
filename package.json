{
  "name": "pi-on-code",
  "publisher": "local",
  "author": "Pi on Code contributors",
  "displayName": "Pi on Code",
  "description": "A keyboard-first Pi coding agent workspace for VS Code",
  "version": "0.1.1",
  "license": "MIT",
  "icon": "pi-icon-light.png",
  "galleryBanner": {
    "color": "#0b0c0e",
    "theme": "dark"
  },
  "keywords": [
    "pi",
    "coding-agent",
    "ai",
    "chat",
    "agent",
    "llm",
    "vscode"
  ],
  "packageManager": "bun@1.3.14",
  "type": "module",
  "engines": {
    "vscode": "^1.118.0"
  },
  "categories": [
    "AI",
    "Chat"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "pi-on-code.codeAgent",
        "title": "Pi: Code Agent",
        "icon": "$(hubot)"
      },
      {
        "command": "pi-on-code.abort",
        "title": "Pi: Abort"
      },
      {
        "command": "pi-on-code.installPi",
        "title": "Pi: Install Pi Coding Agent"
      },
      {
        "command": "pi-on-code.pickModel",
        "title": "Pi: Switch Model"
      },
      {
        "command": "pi-on-code.cycleModel",
        "title": "Pi: Cycle Model"
      },
      {
        "command": "pi-on-code.pickThinkingLevel",
        "title": "Pi: Set Thinking Level"
      },
      {
        "command": "pi-on-code.cycleThinkingLevel",
        "title": "Pi: Cycle Thinking Level"
      },
      {
        "command": "pi-on-code.pickFile",
        "title": "Pi: Pick File to Reference"
      },
      {
        "command": "pi-on-code.pickCommand",
        "title": "Pi: Slash Command Picker"
      },
      {
        "command": "pi-on-code.pickFork",
        "title": "Pi: Fork Session from Message"
      },
      {
        "command": "pi-on-code.exportSession",
        "title": "Pi: Export Session to HTML"
      },
      {
        "command": "pi-on-code.cloneSession",
        "title": "Pi: Clone Session"
      },
      {
        "command": "pi-on-code.login",
        "title": "Pi: Set Up API Key / Login"
      },
      {
        "command": "pi-on-code.resumeSession",
        "title": "Pi: Resume Session"
      },
      {
        "command": "pi-on-code.compact",
        "title": "Pi: Compact Context"
      },
      {
        "command": "pi-on-code.toggleAutoCompaction",
        "title": "Pi: Toggle Auto-Compaction"
      },
      {
        "command": "pi-on-code.toggleAutoRetry",
        "title": "Pi: Toggle Auto-Retry"
      },
      {
        "command": "pi-on-code.addSession",
        "title": "Pi: Add Pi Session",
        "icon": {
          "light": "media/pi-editor-button.svg",
          "dark": "media/pi-editor-dark.svg"
        }
      },
      {
        "command": "pi-on-code.revealEntry",
        "title": "Pi: Reveal Entry in Chat"
      },
      {
        "command": "pi-on-code.copyEntryText",
        "title": "Pi: Copy Entry Text"
      },
      {
        "command": "pi-on-code.focusSession",
        "title": "Pi: Focus Session"
      },
      {
        "command": "pi-on-code.pickSessionModel",
        "title": "Pi: Pick Model for Session"
      },
      {
        "command": "pi-on-code.pickSessionThinking",
        "title": "Pi: Pick Thinking Level for Session"
      },
      {
        "command": "pi-on-code.reloadContext",
        "title": "Pi: Reload Context Files"
      },
      {
        "command": "pi-on-code.forkSession",
        "title": "Pi: Fork Session from Message"
      },
      {
        "command": "pi-on-code.resumePastSession",
        "title": "Pi: Resume Past Session"
      },
      {
        "command": "pi-on-code.deletePastSession",
        "title": "Pi: Delete Past Session"
      },
      {
        "command": "pi-on-code.deleteAllPastSessions",
        "title": "Pi: Delete All Past Sessions",
        "icon": "$(trash)"
      },
      {
        "command": "pi-on-code.filterPastSessions",
        "title": "Pi: Filter Past Sessions",
        "icon": "$(filter)"
      },
      {
        "command": "pi-on-code.installPackage",
        "title": "Pi: Install Package"
      },
      {
        "command": "pi-on-code.uninstallPackage",
        "title": "Pi: Uninstall Package"
      },
      {
        "command": "pi-on-code.searchPackages",
        "title": "Pi: Search Packages",
        "icon": "$(search)"
      },
      {
        "command": "pi-on-code.refreshPackages",
        "title": "Pi: Refresh Packages",
        "icon": "$(refresh)"
      },
      {
        "command": "pi-on-code.updatePackage",
        "title": "Pi: Update Package"
      },
      {
        "command": "pi-on-code.updateAllPackages",
        "title": "Pi: Update All Packages",
        "icon": "$(sync)"
      },
      {
        "command": "pi-on-code.openPiDevMarketplace",
        "title": "Pi: Open Pi.dev Marketplace"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "pi-on-code",
          "title": "Pi on Code",
          "icon": "media/pi-activity.svg"
        }
      ]
    },
    "views": {
      "pi-on-code": [
        {
          "type": "webview",
          "id": "pi-on-code.sessions",
          "name": "Pi"
        }
      ]
    },
    "keybindings": [
      {
        "command": "pi-on-code.codeAgent",
        "key": "ctrl+alt+i",
        "mac": "cmd+alt+i"
      },
      {
        "command": "pi-on-code.pickModel",
        "key": "ctrl+l",
        "mac": "cmd+l"
      },
      {
        "command": "pi-on-code.cycleModel",
        "key": "ctrl+p",
        "mac": "cmd+p"
      },
      {
        "command": "pi-on-code.pickThinkingLevel",
        "key": "ctrl+shift+tab",
        "mac": "cmd+shift+tab"
      },
      {
        "command": "pi-on-code.pickFile",
        "key": "ctrl+shift+@",
        "mac": "cmd+shift+@"
      },
      {
        "command": "pi-on-code.pickCommand",
        "key": "ctrl+/",
        "mac": "cmd+/"
      }
    ],
    "configuration": {
      "title": "Pi on Code",
      "properties": {
        "pi-on-code.promptToInstall": {
          "type": "boolean",
          "default": true,
          "description": "Prompt to install Pi if not found"
        },
        "pi-on-code.anthropicApiKey": {
          "type": "string",
          "default": "",
          "description": "Anthropic API key for Claude models (overrides ANTHROPIC_API_KEY env var at runtime)"
        },
        "pi-on-code.openaiApiKey": {
          "type": "string",
          "default": "",
          "description": "OpenAI API key for GPT models (overrides OPENAI_API_KEY env var at runtime)"
        },
        "pi-on-code.systemPromptAppend": {
          "type": "string",
          "default": "",
          "description": "Additional instructions appended to the pi system prompt"
        },
        "pi-on-code.enableSkills": {
          "type": "boolean",
          "default": true,
          "description": "Load project and global pi skills"
        },
        "pi-on-code.enableContextFiles": {
          "type": "boolean",
          "default": true,
          "description": "Inject project context files (AGENTS.md, inferred project guidelines)"
        },
        "pi-on-code.enablePromptTemplates": {
          "type": "boolean",
          "default": true,
          "description": "Register custom slash commands (e.g. /fix-diagnostics, /explain-code)"
        },
        "pi-on-code.defaultModelProvider": {
          "type": "string",
          "default": "",
          "description": "Default model provider (e.g. 'anthropic'). Empty = auto-detect first available."
        },
        "pi-on-code.defaultModelId": {
          "type": "string",
          "default": "",
          "description": "Default model ID (e.g. 'claude-sonnet-4-5'). Requires defaultModelProvider to be set."
        },
        "pi-on-code.defaultThinkingLevel": {
          "type": "string",
          "default": "off",
          "enum": [
            "off",
            "minimal",
            "low",
            "medium",
            "high",
            "xhigh"
          ],
          "description": "Default thinking level for new sessions"
        },
        "pi-on-code.contextBudget": {
          "type": "number",
          "default": 0,
          "description": "Per-session token budget. 0 = use model default. Increase for longer conversations before auto-compaction."
        },
        "pi-on-code.sessionDir": {
          "type": "string",
          "default": "",
          "description": "Custom session storage directory for session .jsonl files. Empty = use the pi SDK default (~/.pi/agent/sessions/). Equivalent to --session-dir."
        },
        "pi-on-code.autoOpenOnStart": {
          "type": "boolean",
          "default": true,
          "description": "Automatically open the Pi chat tab when VS Code starts. When disabled, sessions initialize in the background but the tab is not revealed until you open it manually."
        }
      }
    },
    "menus": {
      "editor/title": [
        {
          "command": "pi-on-code.addSession",
          "group": "navigation",
          "when": "resourceScheme != pi"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "bun run package",
    "build": "bun run package && bun run vsix:pack",
    "compile": "bun run verify && bun run bundle",
    "bundle": "bun run --parallel bundle:extension bundle:webview",
    "bundle:extension": "bun esbuild.js",
    "bundle:webview": "bun esbuild.webview.js",
    "bundle:production": "bun run --parallel bundle:extension:production bundle:webview:production",
    "bundle:extension:production": "bun esbuild.js --production",
    "bundle:webview:production": "bun esbuild.webview.js --production",
    "watch": "bun run --parallel watch:esbuild watch:webview watch:tsc",
    "watch:esbuild": "bun esbuild.js --watch",
    "watch:webview": "bun esbuild.webview.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "bun run verify && bun run bundle:production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "bun run compile-tests && bun run compile",
    "verify": "bun run --parallel check-types lint",
    "check-types": "bun run --parallel check-types:extension check-types:webview",
    "check-types:extension": "tsc --noEmit",
    "check-types:webview": "tsc --noEmit -p tsconfig.webview.json",
    "lint": "eslint src",
    "test": "vscode-test",
    "vsix": "bun run build",
    "vsix:pack": "bun scripts/build-vsix.mjs",
    "wiki:lint": "bunx tsx agent-wiki/scripts/wiki-lint.ts",
    "wiki:lint:full": "bunx tsx agent-wiki/scripts/wiki-lint.ts --full",
    "publish": "bunx vsce publish --no-yarn --skip-duplicate",
    "un-publish": "bunx vsce unpublish",
    "vsix:openvsx": "bun run package && bunx ovsx publish"
  },
  "devDependencies": {
    "@types/node": "~22.19.19",
    "@types/vscode": "^1.118.0",
    "@vscode/vsce": "^3.9.1",
    "esbuild": "^0.27.7",
    "eslint": "^9.39.4",
    "ovsx": "^0.10.12",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.3",
    "zod": "^4.4.3"
  },
  "optionalDependencies": {
    "@types/mocha": "^10.0.10",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2"
  },
  "trustedDependencies": [
    "@vscode/vsce-sign",
    "esbuild",
    "keytar"
  ],
  "dependencies": {
    "highlight.js": "^11.11.1",
    "morphdom": "^2.7.8"
  }
}
