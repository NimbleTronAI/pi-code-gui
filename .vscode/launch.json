{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Extension",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}",
        "--disable-extensions",
        "${workspaceFolder}"
      ],
      "outFiles": [
        "${workspaceFolder}/dist/extension.js"
      ],
      "sourceMaps": true,
      "resolveSourceMapLocations": [
        "${workspaceFolder}/dist/**",
        "!**/node_modules/**"
      ],
      "preLaunchTask": "watch",
      "env": {
        "NODE_OPTIONS": "--enable-source-maps",
        "PI_ON_CODE_DEV_WORKSPACE": "${workspaceFolder}"
      }
    }
  ]
}
